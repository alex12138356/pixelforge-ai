# ======================
# PixelForge AI Studio — 环境变量示例
# ======================

# ===== OpenAI (必填) =====
# 获取: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# ===== AI 模型配置 (可选) =====
# dall-e-3 ($0.04/张) 或 dall-e-2 ($0.02/张)
MODEL=dall-e-3

# ===== Stripe 支付 (可选) =====
# 获取: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your-key-here

# Stripe Webhook Secret (可选，用于接收订阅事件)
# 获取: Stripe Dashboard → Developers → Webhooks → Add endpoint
# Endpoint URL: https://你的域名.vercel.app/api/webhook
# 监听事件: checkout.session.completed, customer.subscription.*, invoice.*
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Stripe Price IDs (可选，创建产品后使用固定 Price ID)
# 在 Stripe Dashboard 创建产品后设置
# Stripe Price IDs (可选，创建产品后使用固定 Price ID)
# 在 Stripe Dashboard 创建产品后设置
# PRICE_ID_STARTER=price_xxxxxxxxxxxxx
# PRICE_ID_CREATOR=price_xxxxxxxxxxxxx
# PRICE_ID_ENTERPRISE=price_xxxxxxxxxxxxx

# ===== Supabase (可选，用于用户系统) =====
# 注册: https://supabase.com
# SUPABASE_URL=https://xxxxx.supabase.co
# SUPABASE_SERVICE_KEY=service_role_xxxxxxxxxxxx
