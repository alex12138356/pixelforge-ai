# Required: OpenAI API Key (get it at https://platform.openai.com/api-keys)
# DALL-E 3 cost: ~$0.04–$0.08 per image (1024x1024)
# DALL-E 2 cost: ~$0.02 per image (512x512) — cheaper option
OPENAI_API_KEY=sk-your-key-here

# Optional: change model to dall-e-2 for lower cost
MODEL=dall-e-3

# Optional: Stripe for payments (get at https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_your-key-here
