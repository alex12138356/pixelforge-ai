# ======================
# PixelForge AI Studio — 环境变量示例
# ======================

# ===== OpenAI (必填) =====
# 获取: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# ===== AI 模型配置 (可选) =====
# dall-e-3 ($0.04/张) 或 dall-e-2 ($0.02/张)
MODEL=dall-e-3

# ===== Stripe 支付 (可选) =====
# 获取: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your-key-here

# ===== 支付宝当面付 (可选，不配置则自动使用开发模式) =====
# 注册支付宝开放平台: https://open.alipay.com
# 获取 App ID 和密钥后添加以下环境变量到 Vercel：
# ALIPAY_APP_ID=202100xxxxxxxxxxxx
# ALIPAY_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----
# ALIPAY_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
# ALIPAY_NOTIFY_URL=https://pixelforge-ai.vercel.app/api/alipay-notify
# ALIPAY_RETURN_URL=https://pixelforge-ai.vercel.app/?success=true
# ===== Supabase (可选，用于用户系统) =====
# 注册: https://supabase.com
# SUPABASE_URL=https://xxxxx.supabase.co
# SUPABASE_SERVICE_KEY=service_role_xxxxxxxxxxxx
